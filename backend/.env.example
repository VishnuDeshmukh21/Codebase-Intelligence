# =============================================================================
# Codebase Intelligence Server Environment Configuration
# =============================================================================

# MongoDB Connection URI (Local or MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# LLM Provider Configuration
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.8-flash

# Google Gemini API Key (From Google AI Studio https://aistudio.google.com/ or GCP)
GEMINI_API_KEY=your_gemini_api_key_here

# Directory where public Git repositories will be cloned and cached
# Default: ./backend/storage/repos
REPOS_STORAGE_DIR=./storage/repos

# Optional HuggingFace configuration (if LLM_PROVIDER=huggingface)
# HF_MODEL=meta-llama/Meta-Llama-3-8B-Instruct
# HF_TOKEN=your_huggingface_token_here

